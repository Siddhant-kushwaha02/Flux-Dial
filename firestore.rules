rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile: Owners can read/write their own
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Username lookup: Anyone authenticated can read
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Call signaling: Only participants can read/write
    match /calls/{callId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);

      // Allow creation if the creator is the caller
      allow create: if request.auth != null && request.resource.data.callerUid == request.auth.uid;

      // ICE Candidates subcollection
      match /iceCandidates/{participantUid} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid);

        match /candidates/{candidateId} {
          allow read, write: if request.auth != null;
        }
      }
    }
  }
}
